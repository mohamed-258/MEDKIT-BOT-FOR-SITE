{
  "entities": {
    "Setting": {
      "title": "Global Settings",
      "description": "App configuration and admin settings",
      "type": "object",
      "properties": {
        "botToken": { "type": "string" },
        "adminChatId": { "type": "string" },
        "allowedEmails": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Menu": {
      "title": "Subscription Plan",
      "description": "Details about a subscription plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "Ticket": {
      "title": "Subscription Ticket",
      "description": "A user's request for subscription activation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "menuId": { "type": "string" },
        "menuTitle": { "type": "string" },
        "status": { "type": "string" },
        "receiptPhotoUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "settings/global": {
      "schema": "Setting",
      "description": "Global settings document"
    },
    "menus": {
      "schema": "Menu",
      "description": "Collection of subscription plans"
    },
    "tickets": {
      "schema": "Ticket",
      "description": "Collection of user tickets"
    },
    "sessions": {
      "schema": "object",
      "description": "Telegram user sessions"
    },
    "support_messages": {
      "schema": "object",
      "description": "Support chat messages"
    }
  }
}
